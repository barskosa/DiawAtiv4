# Copie para frontend/.env se precisar mudar os endereços padrão.

# Para onde o Vite encaminha /api em `npm run dev` e `npm run preview` (padrão: http://127.0.0.1:8080)
# API_PROXY_TARGET=http://127.0.0.1:8080

# Endereço completo da API usado pelo navegador. Deixe vazio para usar o proxy do Vite (/api).
# Útil em builds publicados em outro servidor; lembre de liberar a origem em CORS_ALLOWED_ORIGINS no backend.
# VITE_API_URL=http://localhost:8080/api
