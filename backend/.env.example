# Copie este arquivo para backend/.env e preencha com seus dados.
# O arquivo .env é ignorado pelo Git: NUNCA publique suas credenciais.

# MongoDB Atlas (recomendado) — copie a connection string em "Connect > Drivers":
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MongoDB local (docker compose up -d na raiz do repositório):
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pokedex

# if-empty (padrão) | always (reimporta o Script_Pokedex.sql) | never
POKEDEX_SEED_MODE=if-empty

# Origens do frontend autorizadas a chamar a API (separadas por vírgula)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
