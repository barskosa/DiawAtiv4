              "mode": "raw",
              "raw": "{\n  \"name\": \"Voltix Turbo\",\n  \"hp\": 70,\n  \"attack\": 80,\n  \"defense\": 50,\n  \"specialAttack\": 95,\n  \"specialDefense\": 60,\n  \"speed\": 130,\n  \"types\": [\n    \"Electric\"\n  ]\n}",
