                "25"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Pikachu', () => pm.expect(pm.response.json().name).to.eql('Pikachu'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar (Voltix)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pokemons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pokemons"
              ]
            },
            "description": "O id é opcional: sem ele a API usa o próximo número livre. Guarda o id criado em {{createdId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Voltix\",\n  \"hp\": 70,\n  \"attack\": 80,\n  \"defense\": 50,\n  \"specialAttack\": 95,\n  \"specialDefense\": 60,\n  \"speed\": 110,\n  \"types\": [\n    \"Electric\",\n    \"Steel\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('createdId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar (Voltix Turbo)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
