{
  "info": {
    "name": "Pokédex API - Atividade 04",
    "description": "Endpoints da API REST da Pokédex (Spring Boot + MongoDB). Importe no Postman, Insomnia ou Thunder Client. A variável baseUrl aponta para http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Pokémon (obrigatórios)",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pokemons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pokemons"
              ]
            },
            "description": "Lista os Pokémon ordenados pelo número."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('lista com Pokémon', () => pm.expect(pm.response.json().length).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar por ID (Pikachu)",
